<?xml version="1.0"?>
<!-- Hydra's Android manifest.

     It exists for one reason at the moment: to name the launcher icon, so the
     app wears the drawing in `icon/` rather than Qt's default. Everything else
     here is what androiddeployqt generates, kept minimal on purpose — a manifest
     copied wholesale from a template is a pile of permissions nobody chose.
-->
<!-- The version attributes below are filled by androiddeployqt from
     ANDROID_VERSION_CODE / ANDROID_VERSION_NAME in hydra.pro. The name comes
     from the VERSION file directly; the code is derived from it by
     tool/android.mk and passed to qmake. For a while it was not passed at
     all: the .pro assigned 1 unconditionally and won, so this file was
     filled with a versionCode the build had already computed differently,
     and the preflight reported the number nobody shipped.

     (No double hyphen anywhere in this comment. XML forbids it, and
     androiddeployqt rejects the file with "Expected '>', but got ' '",
     which names a column rather than the reason.) Left as the literal placeholders on purpose:
     written out by hand they drift from the real version, and this manifest
     carried neither attribute at all, which is how the apk came to report an
     empty versionCode, which is an apk that no later build can ever be an
     upgrade of. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="se.vibes.hydra"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Background audio. A page playing sound went silent the moment the
         browser was backgrounded: Android's audio service showed the player
         moving from started to stopped while the process stayed alive, so
         nothing had been killed. An app in the background is simply not
         entitled to sustained playback unless it holds a foreground service,
         and the media playback type is the one that describes this honestly.

         POST_NOTIFICATIONS is here because a foreground service is required to
         show a notification and, from API 33, showing one requires the user's
         permission. Below 33 it is granted by installing; at or above it, a
         refusal hides the notification without stopping the service, so the
         sound keeps playing and only the label for it is missing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Camera and microphone, for a page that calls getUserMedia: a video
         call in the browser is the case, and Teams web is the one asked for.

         A WebView cannot capture without these however the page is answered,
         and it cannot capture with them alone either: the WebChromeClient has
         to answer onPermissionRequest, and the app has to hold the runtime
         grant. Three separate things, none of which is sufficient, which is
         why adding a line here on its own changes nothing.

         MODIFY_AUDIO_SETTINGS is what lets the engine route capture and
         playback sensibly during a call rather than fighting whatever the
         last app left the stream on.

         Declared, never demanded. android:required="false" on the features
         below so a device without a camera can still install a browser; a
         browser that a tablet refuses because it has no front camera would be
         a worse outcome than one where a video call cannot start. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- Plain HTTP is allowed because this is a browser. Android blocks
         cleartext by default, which is right for an app that talks to its own
         backend and wrong for one whose entire job is loading addresses the
         user typed: an http:// page would fail with ERR_CLEARTEXT_NOT_PERMITTED
         and look like a broken browser rather than a policy. Measured: that is
         exactly what the first working render showed. -->
    <application android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:label="Hydra"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">
        <activity android:name="org.qtproject.qt.android.bindings.QtActivity"
            android:label="Hydra"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="hydra"/>
        </activity>
        <!-- Not exported: nothing outside this app has any business starting
             it, and a foreground service another app can start is one another
             app can use to keep this process alive. -->
        <service android:name="se.vibes.hydra.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
    </application>
</manifest>

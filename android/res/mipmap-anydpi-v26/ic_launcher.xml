<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by icon/build_icons.py.

     This file is why the icon is not small and white. A
     launcher on API 26 or above prefers it over the PNG and
     masks these two layers to its own shape; without it the
     PNG gets the legacy treatment instead, which shrinks the
     drawing onto a white plate. minSdk is 26, so this is the
     icon on every device the app supports.

     No <monochrome>: the themed icons of API 33 want a flat
     single-colour silhouette, and reducing this drawing to
     one is redrawing it rather than generating it. Absent,
     a themed launcher falls back to these two layers. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>

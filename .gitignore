# Build output
/build/
/tests/build/
/build-android/
/build-qmake/
/tests/build-make/
# fmake's object cache. It grew to 146 MB under src/ from a trial nobody
# cleaned up, and an ignored directory is one nothing reminds you about.
.fmake/
*.o
*.obj
# Core dumps land beside whatever crashed, and a driver that segfaults leaves
# one in tests/. They are build wreckage, not evidence worth keeping.
core
core.*
*.moc
moc_*.cpp
qrc_*.cpp

# Runtime state written next to a tree file
/state/
policy.json

# Captured evidence from live pages. Kept on disk on purpose -- the conclusions
# in project.md refer to these and re-capturing is not re-reading, since the
# site moves on -- but not committed: a capture is somebody else's urls, some
# with tokens in them, and publishing one is a separate decision from keeping
# it. See evidence/README.md, which is itself ignored.
/evidence/

# Agent worktrees and session scratch. `.claude/worktrees/` holds entire
# checkouts of this repo, so an unguarded `git add -A` would stage a copy of
# the tree inside itself.
/.claude/

# Editor / OS cruft
*.user
.DS_Store
*.swp

# debhelper's working state; debian/ holds packaging sources only.
debian/.debhelper/
debian/files
debian/tmp/
debian/hydra/
debian/*.substvars
debian/*.debhelper.log
debian/debhelper-build-stamp

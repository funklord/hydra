+++ b/src/core/api/qwebengineclienthints.cpp
@@ -149,6 +149,26 @@
 }
 
 /*!
+    \property QWebEngineClientHints::brandVersionList
+    The value of the \c{Sec-CH-UA} HTTP header and \c{brands} member of NavigatorUAData in JavaScript.
+
+    It holds brand name and major version pairs in a QVariantMap, and is the
+    low-entropy counterpart of fullVersionList: sent with every request, and
+    visible to pages, frames and workers alike. Set it together with
+    fullVersionList and the user agent string so that all three agree.
+*/
+QVariantMap QWebEngineClientHints::brandVersionList() const
+{
+    QVariantMap ret;
+    if (!m_profileAdapter)
+        return ret;
+    QJsonObject brandVersionList = m_profileAdapter->clientHint(QtWebEngineCore::ProfileAdapter::UABrandVersionList).toJsonObject();
+    for (const QString &key : brandVersionList.keys())
+        ret.insert(key, brandVersionList.value(key).toVariant());
+    return ret;
+}
+
+/*!
     \property QWebEngineClientHints::wow64
     The value of the \c{Sec-CH-UA-Wow64} HTTP header and \c{wow64} member of NavigatorUAData in JavaScript.
 */
@@ -218,6 +238,16 @@
     m_profileAdapter->setClientHint(QtWebEngineCore::ProfileAdapter::UAFullVersionList, QVariant(jsonObject));
 }
 
+void QWebEngineClientHints::setBrandVersionList(const QVariantMap &brandVersionList)
+{
+    if (!m_profileAdapter)
+        return;
+    QJsonObject jsonObject;
+    for (auto i = brandVersionList.cbegin(), end = brandVersionList.cend(); i != end; ++i)
+        jsonObject.insert(i.key(), QJsonValue(i.value().toString()));
+    m_profileAdapter->setClientHint(QtWebEngineCore::ProfileAdapter::UABrandVersionList, QVariant(jsonObject));
+}

From: Nabeel Sowan <funklord@vibes.se>
Subject: [PATCH] QWebEngineClientHints: add brandVersionList

QWebEngineClientHints can set the full version list, the high-entropy
Sec-CH-UA-Full-Version-List, but not the brand list itself: Sec-CH-UA,
sent with every request, and navigator.userAgentData.brands in pages,
frames and workers. Those keep the embedded Chromium's own version
whatever an application sets, so a browser that sets its user agent and
full version list consistently still presents two versions at once --
which is what bot checks compare, and a fingerprint of its own.

Add brandVersionList beside fullVersionList, backed by the same
blink::UserAgentMetadata, setting brand_version_list.

---
--- a/src/core/profile_adapter.h
+++ b/src/core/profile_adapter.h
@@ -148,6 +148,7 @@
         UABitness,
         UAFullVersionList,
         UAWOW64,
+        UABrandVersionList,
     };
 
     HttpCacheType httpCacheType() const;
--- a/src/core/profile_adapter.cpp
+++ b/src/core/profile_adapter.cpp
@@ -655,6 +655,12 @@
         }
     case ProfileAdapter::UAWOW64:
         return QVariant(userAgentMetadata.wow64);
+    case ProfileAdapter::UABrandVersionList: {
+            QJsonObject ret;
+            for (const auto &value : userAgentMetadata.brand_version_list)
+                ret.insert(toQString(value.brand), QJsonValue(toQString(value.version)));
+            return QVariant(ret);
+        }
     default:
         return QVariant();
     }
@@ -698,6 +704,16 @@
     case ProfileAdapter::UAWOW64:
         userAgentMetadata.wow64 = value.toBool();
         break;
+    case ProfileAdapter::UABrandVersionList: {
+        userAgentMetadata.brand_version_list.clear();
+        QJsonObject brandVersionList = value.toJsonObject();
+        for (const QString &key : brandVersionList.keys())
+            userAgentMetadata.brand_version_list.push_back({
+                key.toStdString(),
+                brandVersionList.value(key).toString().toStdString()
+            });
+        break;
+    }
     default:
         break;
     }
